<VBox prefHeight="700" prefWidth="1200" style="-fx-background-color: #0B1F3A;" xmlns="http://javafx.com/javafx/25"  xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom9.auction.baitaplon_ltnc_nhom9.ui.controller.GUIController">

