<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="560" prefWidth="960" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom9.auction.baitaplon_ltnc_nhom9.ui.controller.LoginController">

    <!-- BACKGROUND -->
    <AnchorPane prefHeight="560" prefWidth="960" style="-fx-background-color: linear-gradient(to bottom right, #0B1F3A 0%, #143A51 60%, #1a4a63 100%);">
        <Circle layoutX="-40" layoutY="560" radius="260" style="-fx-fill: rgba(196,154,104,0.08);" />
        <Circle layoutX="480" layoutY="-30" radius="180" style="-fx-fill: rgba(20,58,81,0.6);" />
        <Circle layoutX="960" layoutY="100" radius="140" style="-fx-fill: rgba(255,214,109,0.07);" />
        <Circle layoutX="240" layoutY="300" radius="200" style="-fx-fill: rgba(116,108,107,0.10);" />
        <Circle layoutX="820" layoutY="500" radius="90" style="-fx-fill: rgba(196,154,104,0.10);" />
        <Rectangle height="3" layoutX="0" layoutY="0" style="-fx-fill: linear-gradient(to right, transparent, #C49A68, #FFD66D, #C49A68, transparent);" width="960" />
    </AnchorPane>

    <!-- MAIN CONTENT -->
    <HBox alignment="CENTER" prefHeight="560" prefWidth="960" spacing="0">

        <!-- LEFT PANEL -->
        <VBox alignment="TOP_LEFT" prefHeight="820" prefWidth="533" style="-fx-padding: 40 44 40 54;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 16px; -fx-text-fill: #FFD66D;" text="◆" />
                <Label style="-fx-font-family: 'Arial Black'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFD66D;" text="UBid" />
            </HBox>
            <Label style="-fx-font-family: 'Georgia'; -fx-font-size: 52px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 2, 3);" text="WELCOME." />
            <HBox style="-fx-padding: 0 0 0 4;">
                <Label prefWidth="450" style="-fx-text-fill: #C49A68; -fx-font-size: 13px;" text="━━━━━━━━━━━━━━━◆━━━━━━━━━━━━━━━━━" />
            </HBox>
            <Label style="-fx-font-family: 'Arial'; -fx-font-size: 13px; -fx-text-fill: #C49A68;" text="Giao diện hiện đại, trải nghiệm tuyệt vời" />
            <Label prefWidth="380" style="-fx-font-family: 'Arial'; -fx-font-size: 12.5px; -fx-text-fill: rgba(255,255,255,0.65); -fx-line-spacing: 5;" text="Đăng nhập để truy cập tất cả tính năng đặc biệt&#10;dành riêng cho thành viên. Nền tảng của chúng&#10;tôi mang lại trải nghiệm tốt nhất cho bạn." wrapText="true" />
            <StackPane fx:id="imageContainer" prefHeight="360" prefWidth="436" style="-fx-border-radius: 14; -fx-border-width: 1.2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 16, 0, 2, 6);">
                <ImageView fx:id="heroImage" fitHeight="345" fitWidth="433" pickOnBounds="true" preserveRatio="true" smooth="true" />
                <VBox fx:id="imagePlaceholder" alignment="CENTER" mouseTransparent="true" prefHeight="393" prefWidth="434" spacing="5" />
            </StackPane>
        </VBox>

        <!-- RIGHT PANEL -->
        <VBox alignment="CENTER" prefHeight="820" prefWidth="514" style="-fx-padding: 0 50 0 10;">

            <!-- ════════ LOGIN CARD (hiện mặc định) ════════ -->
            <VBox fx:id="loginCard" alignment="TOP_CENTER" managed="true" prefHeight="641.0" prefWidth="454.0" spacing="0" style="-fx-background-color: rgba(11,31,58,0.82);                          -fx-background-radius: 22; -fx-padding: 32 32 28 32;                          -fx-border-color: #C49A68; -fx-border-radius: 22; -fx-border-width: 1.2;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 30, 0, 0, 10);" visible="true">

                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-family: 'Arial'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFD66D;" text="MEMBER LOGIN" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label style="-fx-text-fill: #C49A68; -fx-font-size: 10px;" text="━━━━" />
                        <Label style="-fx-text-fill: #FFD66D; -fx-font-size: 8px;" text="◆" />
                        <Label style="-fx-text-fill: #C49A68; -fx-font-size: 10px;" text="━━━━" />
                    </HBox>
                </VBox>

                <VBox spacing="6" style="-fx-padding: 14 0 0 0;">
                    <Label prefHeight="22.0" prefWidth="79.0" style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Tên đăng nhập" />
                    <TextField fx:id="loginUsername" prefHeight="40.0" prefWidth="388" promptText="ENTER USERNAME" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                       -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 11 14;                                       -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <VBox spacing="6" style="-fx-padding: 12 0 0 0;">
                    <Label prefHeight="36.0" prefWidth="48.0" style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Mật khẩu" />
                    <PasswordField fx:id="loginPassword" prefHeight="16.0" prefWidth="388.0" promptText="ENTER PASSWORD" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                           -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 11 14;                                           -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 10 0 0 0;">
                    <VBox spacing="6">
                        <CheckBox fx:id="rememberMe" prefHeight="26.0" prefWidth="76.0" style="-fx-font-size: 11px; -fx-text-fill: #746C6B; -fx-font-family: 'Arial';" text="Remember" />
                        <Hyperlink onAction="#forgotPassword" prefHeight="28.0" prefWidth="108.0" style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-border-color: transparent; -fx-padding: 0;" text="Forgot the password?" />
                    </VBox>
                </HBox>

                <Label fx:id="loginError" managed="false" prefWidth="388" style="-fx-text-fill: #FFD66D; -fx-font-size: 11px;" text="" visible="false" wrapText="true" />

                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 16 0 12 0;">
                    <Label style="-fx-text-fill: #2a4a5e; -fx-font-size: 10px;" text="──────" />
                    <Button fx:id="btnLogin" onAction="#onLogin" prefHeight="38.0" prefWidth="108" style="-fx-background-color: #FFD66D; -fx-text-fill: #0B1F3A;                                    -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Arial';                                    -fx-background-radius: 22; -fx-cursor: hand;                                    -fx-effect: dropshadow(gaussian, rgba(255,214,109,0.5), 14, 0, 0, 4);" text="LOGIN" />
                    <Label style="-fx-text-fill: #2a4a5e; -fx-font-size: 10px;" text="──────" />
                </HBox>

                <VBox alignment="CENTER" spacing="8">
                    <Label prefHeight="51.0" prefWidth="105.0" style="-fx-font-size: 12px; -fx-text-fill: #746C6B; -fx-font-family: 'Arial';" text="Chưa có tài khoản?" />
                    <Button maxWidth="Infinity" onAction="#handleRegister" prefHeight="45.0" prefWidth="388.0" style="-fx-background-color: transparent; -fx-text-fill: #FFD66D;                                    -fx-font-weight: bold; -fx-font-size: 12px; -fx-font-family: 'Arial';                                    -fx-border-color: #C49A68; -fx-border-radius: 22; -fx-background-radius: 22;                                    -fx-padding: 9 0; -fx-cursor: hand;" text="ĐĂNG KÝ NGAY" />
                </VBox>
            </VBox>

            <!-- ════════ REGISTER CARD (ẩn mặc định) ════════ -->
            <VBox fx:id="registerCard" alignment="TOP_CENTER" managed="false" prefWidth="420" spacing="0" style="-fx-background-color: rgba(11,31,58,0.82);                          -fx-background-radius: 22; -fx-padding: 26 32 22 32;                          -fx-border-color: #C49A68; -fx-border-radius: 22; -fx-border-width: 1.2;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 30, 0, 0, 10);" visible="false">

                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-family: 'Arial'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFD66D;" text="ĐĂNG KÝ TÀI KHOẢN" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label style="-fx-text-fill: #C49A68; -fx-font-size: 10px;" text="━━━━" />
                        <Label style="-fx-text-fill: #FFD66D; -fx-font-size: 8px;" text="◆" />
                        <Label style="-fx-text-fill: #C49A68; -fx-font-size: 10px;" text="━━━━" />
                    </HBox>
                </VBox>

                <VBox spacing="6" style="-fx-padding: 12 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Họ và Tên" />
                    <TextField fx:id="regFullName" prefHeight="38" prefWidth="388" promptText="ENTER FULL NAME" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                       -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 9 14;                                       -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <VBox spacing="6" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Tên đăng nhập" />
                    <TextField fx:id="regUsername" prefHeight="38" prefWidth="388" promptText="ENTER USERNAME" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                       -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 9 14;                                       -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <VBox spacing="6" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Email" />
                    <TextField fx:id="regEmail" prefHeight="38" prefWidth="388" promptText="ENTER EMAIL" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                       -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 9 14;                                       -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <VBox spacing="6" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Mật khẩu" />
                    <PasswordField fx:id="regPassword" prefHeight="38" promptText="ENTER PASSWORD" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                           -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 9 14;                                           -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <VBox spacing="6" style="-fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #C49A68; -fx-font-family: 'Arial'; -fx-font-weight: bold;" text="Xác nhận mật khẩu" />
                    <PasswordField fx:id="regConfirm" prefHeight="38" promptText="CONFIRM PASSWORD" style="-fx-background-color: rgba(20,58,81,0.7); -fx-border-color: #746C6B;                                           -fx-border-radius: 9; -fx-background-radius: 9; -fx-padding: 9 14;                                           -fx-font-size: 12px; -fx-text-fill: white; -fx-prompt-text-fill: #746C6B;" />
                </VBox>

                <Label fx:id="regError" managed="false" prefWidth="388" style="-fx-text-fill: #FFD66D; -fx-font-size: 11px; -fx-padding: 6 0 0 0;" text="" visible="false" wrapText="true" />

                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 14 0 10 0;">
                    <Label style="-fx-text-fill: #2a4a5e; -fx-font-size: 10px;" text="──────" />
                    <Button onAction="#onRegister" prefHeight="40" prefWidth="120" style="-fx-background-color: #FFD66D; -fx-text-fill: #0B1F3A;                                    -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Arial';                                    -fx-background-radius: 22; -fx-cursor: hand;                                    -fx-effect: dropshadow(gaussian, rgba(255,214,109,0.5), 14, 0, 0, 4);" text="ĐĂNG KÝ" />
                    <Label style="-fx-text-fill: #2a4a5e; -fx-font-size: 10px;" text="──────" />
                </HBox>

                <VBox alignment="CENTER" spacing="8">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #746C6B; -fx-font-family: 'Arial';" text="Đã có tài khoản?" />
                    <Button maxWidth="Infinity" onAction="#handleBackToLogin" prefHeight="35" prefWidth="354" style="-fx-background-color: transparent; -fx-text-fill: #FFD66D;                                    -fx-font-weight: bold; -fx-font-size: 12px; -fx-font-family: 'Arial';                                    -fx-border-color: #C49A68; -fx-border-radius: 22; -fx-background-radius: 22;                                    -fx-padding: 9 0; -fx-cursor: hand;" text="ĐĂNG NHẬP NGAY" />
                </VBox>
            </VBox>

        </VBox>
    </HBox>

</StackPane>
