<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<!--
  RegisterView — cùng layout với LoginView (split 52/48).
  Stylesheet: dùng style.css (shared) + register.css (register-specific).
  ScrollPane ở cột phải để form có thể scroll khi cửa sổ nhỏ.

  THAY ĐỔI: Thêm phần điều khoản (terms) dành cho NGƯỜI BÁN.
  Phần này chỉ hiện ra khi user chọn toggle "NGƯỜI BÁN".
  Gồm 3 checkbox riêng biệt cho 3 loại điều khoản.
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nhom9.auction.baitaplon_ltnc_nhom9.ui.controller.RegisterController"
           styleClass="root-pane"
           stylesheets="@../css/style.css, @../css/register.css"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <!-- Vòng trang trí nền (giống LoginView) -->
    <StackPane styleClass="bg-decorations" maxWidth="Infinity" maxHeight="Infinity"
               mouseTransparent="true">
        <Circle styleClass="deco-circle" radius="220" translateX="-40" translateY="-80"/>
        <Circle styleClass="deco-circle" radius="320" translateX="20" translateY="120"/>
        <Circle styleClass="deco-circle" radius="180" translateX="-120" translateY="200"/>
    </StackPane>

    <!-- ToggleGroup cho việc chọn vai trò -->
    <fx:define>
        <ToggleGroup fx:id="roleGroup"/>
    </fx:define>

    <GridPane styleClass="main-grid" maxWidth="Infinity" maxHeight="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="52.0" minWidth="300.0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="48.0" minWidth="340.0" hgrow="SOMETIMES"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" minHeight="500.0"/>
        </rowConstraints>

        <!-- CỘT TRÁI — Brand Panel (giữ nguyên) -->
        <VBox styleClass="brand-panel"
              GridPane.columnIndex="0" GridPane.rowIndex="0"
              maxWidth="Infinity" maxHeight="Infinity">

            <VBox styleClass="brand-inner" maxWidth="Infinity">
                <HBox styleClass="premium-badge" alignment="CENTER">
                    <Label text="★" styleClass="badge-star"/>
                    <Label text="ĐẤU GIÁ CAO CẤP"/>
                </HBox>
                <Label text="UBID" styleClass="brand-title"/>
                <StackPane prefHeight="10">
                    <Line startX="0" endX="260" styleClass="divider-line"/>
                    <Circle styleClass="divider-dot" radius="4"/>
                </StackPane>
                <Label text="Tham gia cộng đồng" styleClass="tagline"/>
                <Label text="Tạo tài khoản và bắt đầu đấu giá hoặc bán hàng trên nền tảng đấu giá trực tuyến an toàn, thời gian thực được hàng nghìn người tin dùng."
                       styleClass="description" wrapText="true"/>
                <VBox styleClass="feature-list">
                    <HBox styleClass="feature-item" alignment="CENTER_LEFT" spacing="10">
                        <Label text="✓" styleClass="feature-check"/>
                        <Label text="Đấu giá trực tiếp bảo mật" styleClass="feature-text"/>
                    </HBox>
                    <HBox styleClass="feature-item" alignment="CENTER_LEFT" spacing="10">
                        <Label text="✓" styleClass="feature-check"/>
                        <Label text="Tài khoản Người mua &amp; Người bán" styleClass="feature-text"/>
                    </HBox>
                    <HBox styleClass="feature-item" alignment="CENTER_LEFT" spacing="10">
                        <Label text="✓" styleClass="feature-check"/>
                        <Label text="Thông báo đấu giá tức thì" styleClass="feature-text"/>
                    </HBox>
                    <HBox styleClass="feature-item" alignment="CENTER_LEFT" spacing="10">
                        <Label text="✓" styleClass="feature-check"/>
                        <Label text="Hỗ trợ ví &amp; thanh toán" styleClass="feature-text"/>
                    </HBox>
                </VBox>
                <VBox styleClass="gavel-wrap">
                    <StackPane styleClass="gavel-circle">
                        <Label text="📝" styleClass="gavel-icon"/>
                    </StackPane>
                </VBox>
            </VBox>
        </VBox>

        <!-- CỘT PHẢI — Register Form (bọc trong ScrollPane) -->
        <ScrollPane styleClass="form-scroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    GridPane.columnIndex="1" GridPane.rowIndex="0">

            <VBox styleClass="register-scroll-wrapper"
                  alignment="CENTER"
                  minHeight="680">

                <VBox styleClass="register-card" fillWidth="true">

                    <!-- Header -->
                    <VBox styleClass="card-header">
                        <Label text="TẠO TÀI KHOẢN" styleClass="card-title"/>
                        <StackPane prefHeight="8">
                            <Line startX="0" endX="70" styleClass="card-title-line"/>
                        </StackPane>
                    </VBox>

                    <!-- Chọn vai trò -->
                    <VBox styleClass="field-group">
                        <Label text="Tôi muốn" styleClass="field-label"/>
                        <HBox styleClass="role-toggle-group" spacing="0">
                            <ToggleButton fx:id="buyerToggle"
                                          text="🛒  NGƯỜI MUA"
                                          toggleGroup="$roleGroup"
                                          styleClass="role-toggle, role-toggle-left"
                                          HBox.hgrow="ALWAYS"
                                          maxWidth="Infinity"/>
                            <ToggleButton fx:id="sellerToggle"
                                          text="🏷  NGƯỜI BÁN"
                                          toggleGroup="$roleGroup"
                                          styleClass="role-toggle, role-toggle-right"
                                          HBox.hgrow="ALWAYS"
                                          maxWidth="Infinity"/>
                        </HBox>
                    </VBox>

                    <!-- Các trường nhập liệu (giữ nguyên) -->
                    <VBox styleClass="form-fields">

                        <!-- Hàng 1: Họ tên + Tên đăng nhập -->
                        <GridPane styleClass="field-row-grid" hgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox styleClass="field-group" GridPane.columnIndex="0">
                                <Label text="Họ và tên" styleClass="field-label"/>
                                <TextField fx:id="fullNameField"
                                           styleClass="input-field"
                                           promptText="NHẬP HỌ VÀ TÊN"/>
                                <Label fx:id="fullNameError"
                                       styleClass="error-label"
                                       text=""
                                       visible="false"
                                       managed="false"/>
                            </VBox>

                            <VBox styleClass="field-group" GridPane.columnIndex="1">
                                <Label text="Tên đăng nhập" styleClass="field-label"/>
                                <TextField fx:id="usernameField"
                                           styleClass="input-field"
                                           promptText="CHỮ &amp; SỐ"/>
                                <Label fx:id="usernameError"
                                       styleClass="error-label"
                                       text=""
                                       visible="false"
                                       managed="false"/>
                            </VBox>
                        </GridPane>

                        <!-- Hàng 2: Email + Số điện thoại -->
                        <GridPane styleClass="field-row-grid" hgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="60"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="40"/>
                            </columnConstraints>

                            <VBox styleClass="field-group" GridPane.columnIndex="0">
                                <Label text="Địa chỉ Email" styleClass="field-label"/>
                                <TextField fx:id="emailField"
                                           styleClass="input-field"
                                           promptText="EMAIL"/>
                                <Label fx:id="emailError"
                                       styleClass="error-label"
                                       text=""
                                       visible="false"
                                       managed="false"/>
                            </VBox>

                            <VBox styleClass="field-group" GridPane.columnIndex="1">
                                <Label text="Số điện thoại" styleClass="field-label"/>
                                <TextField fx:id="phoneField"
                                           styleClass="input-field"
                                           promptText="TÙY CHỌN"/>
                                <Label fx:id="phoneError"
                                       styleClass="error-label"
                                       text=""
                                       visible="false"
                                       managed="false"/>
                            </VBox>
                        </GridPane>

                        <!-- Mật khẩu -->
                        <VBox styleClass="field-group">
                            <Label text="Mật khẩu" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField"
                                           styleClass="input-field"
                                           promptText="TỐI THIỂU 8 KÝ TỰ · HOA + THƯỜNG + SỐ"/>
                            <ProgressBar fx:id="strengthBar"
                                         styleClass="strength-bar"
                                         progress="0"
                                         maxWidth="Infinity"
                                         prefHeight="4"/>
                            <Label fx:id="strengthLabel"
                                   styleClass="strength-label"
                                   text=""
                                   visible="false"
                                   managed="false"/>
                            <Label fx:id="passwordError"
                                   styleClass="error-label"
                                   text=""
                                   visible="false"
                                   managed="false"/>
                        </VBox>

                        <!-- Xác nhận mật khẩu -->
                        <VBox styleClass="field-group">
                            <Label text="Xác nhận mật khẩu" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           styleClass="input-field"
                                           promptText="NHẬP LẠI MẬT KHẨU"/>
                            <Label fx:id="confirmError"
                                   styleClass="error-label"
                                   text=""
                                   visible="false"
                                   managed="false"/>
                        </VBox>

                    </VBox>

                    <!-- ================================================ -->
                    <!--   ĐIỀU KHOẢN NGƯỜI BÁN                           -->
                    <!--   Chỉ hiện khi chọn toggle "NGƯỜI BÁN"           -->
                    <!--   Controller sẽ toggle visible/managed            -->
                    <!-- ================================================ -->
                    <VBox fx:id="sellerTermsSection"
                          styleClass="seller-terms-section"
                          visible="false"
                          managed="false">

                        <!-- Tiêu đề phần điều khoản -->
                        <HBox styleClass="terms-header" alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋" styleClass="terms-header-icon"/>
                            <VBox>
                                <Label text="ĐIỀU KHOẢN NGƯỜI BÁN" styleClass="terms-header-title"/>
                                <Label text="Đọc và chấp nhận tất cả điều khoản để hoàn tất đăng ký"
                                       styleClass="terms-header-sub" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <!-- Điều khoản 1: Hàng hóa -->
                        <VBox styleClass="terms-item">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="termsMerchandiseCheck"
                                          styleClass="terms-check"/>
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Chính sách về Hàng hóa"
                                           styleClass="terms-item-title"/>
                                    <Label text="Quy định loại hàng được bán, tiêu chuẩn chất lượng và hàng cấm."
                                           styleClass="terms-item-desc" wrapText="true"/>
                                </VBox>
                                <Button text="Xem"
                                        styleClass="terms-view-btn"
                                        onAction="#onViewMerchandiseTerms"/>
                            </HBox>
                            <Label fx:id="termsMerchandiseError"
                                   styleClass="error-label, terms-error"
                                   text="⚠  Vui lòng chấp nhận chính sách hàng hóa"
                                   visible="false" managed="false"/>
                        </VBox>

                        <Separator styleClass="terms-sep"/>

                        <!-- Điều khoản 2: Nội dung -->
                        <VBox styleClass="terms-item">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="termsContentCheck"
                                          styleClass="terms-check"/>
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Chính sách về Nội dung"
                                           styleClass="terms-item-title"/>
                                    <Label text="Quy định mô tả sản phẩm, hình ảnh và nội dung đăng tải."
                                           styleClass="terms-item-desc" wrapText="true"/>
                                </VBox>
                                <Button text="Xem"
                                        styleClass="terms-view-btn"
                                        onAction="#onViewContentTerms"/>
                            </HBox>
                            <Label fx:id="termsContentError"
                                   styleClass="error-label, terms-error"
                                   text="⚠  Vui lòng chấp nhận chính sách nội dung"
                                   visible="false" managed="false"/>
                        </VBox>

                        <Separator styleClass="terms-sep"/>

                        <!-- Điều khoản 3: Bảo mật -->
                        <VBox styleClass="terms-item">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="termsPrivacyCheck"
                                          styleClass="terms-check"/>
                                <VBox HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="Chính sách Bảo mật Thông tin"
                                           styleClass="terms-item-title"/>
                                    <Label text="Cách chúng tôi thu thập, sử dụng và bảo vệ thông tin cá nhân."
                                           styleClass="terms-item-desc" wrapText="true"/>
                                </VBox>
                                <Button text="Xem"
                                        styleClass="terms-view-btn"
                                        onAction="#onViewPrivacyTerms"/>
                            </HBox>
                            <Label fx:id="termsPrivacyError"
                                   styleClass="error-label, terms-error"
                                   text="⚠  Vui lòng chấp nhận chính sách bảo mật"
                                   visible="false" managed="false"/>
                        </VBox>

                    </VBox>
                    <!-- ================================================ -->
                    <!--   KẾT THÚC ĐIỀU KHOẢN NGƯỜI BÁN                  -->
                    <!-- ================================================ -->

                    <!-- Nút đăng ký chính -->
                    <Button text="TẠO TÀI KHOẢN"
                            styleClass="primary-button"
                            defaultButton="true"
                            maxWidth="Infinity"
                            onAction="#onRegister"/>

                    <!-- Chuyển về Login -->
                    <Label text="Đã có tài khoản?" styleClass="secondary-hint"/>
                    <Button text="ĐĂNG NHẬP"
                            styleClass="outline-button"
                            maxWidth="Infinity"
                            onAction="#onBackToLogin"/>

                </VBox>

            </VBox>

        </ScrollPane>
    </GridPane>
</StackPane>
