<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  HomeView.fxml — UBid | Controller: HomeCoordinator + HomeLoginCoordinator
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.nhom9.auction.baitaplon_ltnc_nhom9.ui.controller.HomeController"
            stylesheets="@../css/home.css"
            styleClass="root">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT">

            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <StackPane styleClass="logo-circle">
                    <Label styleClass="logo-icon-label" text="⚡"/>
                </StackPane>
                <Label styleClass="app-name" text="UBid"/>
            </HBox>

            <!-- "Danh mục" đã được đổi thành "Kết quả" theo yêu cầu -->
            <HBox styleClass="nav-links" HBox.hgrow="NEVER">
                <Button styleClass="nav-link-active" text="Trang chủ" onAction="#handleNavHome"/>
                <Button styleClass="nav-link" text="Kết quả" onAction="#handleNavResults"/>
            </HBox>

            <HBox styleClass="navbar-right" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="12">
                <Button styleClass="icon-btn" text="🔍" onAction="#handleSearch"/>
                <!-- Bell icon + badge đỏ (badge ẩn khi = 0, hiện khi > 0) -->
                <StackPane styleClass="bell-wrapper">
                    <Button fx:id="btnBell" styleClass="icon-btn" text="🔔"
                            onAction="#handleNotifications"/>
                    <Label fx:id="lblBellBadge"
                           styleClass="bell-badge"
                           text="0"
                           visible="false"
                           managed="false"
                           StackPane.alignment="TOP_RIGHT"
                           translateX="6" translateY="-4"/>
                </StackPane>
                <Region minWidth="8"/>
                <Button fx:id="btnLogInProminent"
                        styleClass="btn-login-solid"
                        text="Đăng nhập"
                        onAction="#handleLogin"/>
                <Button fx:id="btnUserAvatar"
                        styleClass="avatar-menu-btn"
                        maxWidth="40" maxHeight="40"
                        minWidth="40" minHeight="40"
                        onAction="#handleAvatarPressed"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="mainStack">

            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 1: Nội dung Home chính (scroll)
                 ═══════════════════════════════════════════════════════════ -->
            <ScrollPane fx:id="homeScrollPane" fitToWidth="true"
                        styleClass="scroll-pane"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">

                <VBox styleClass="main-content" spacing="24">

                    <HBox styleClass="search-section" spacing="12" alignment="CENTER_LEFT">
                        <HBox styleClass="search-bar-container" HBox.hgrow="ALWAYS" spacing="8" alignment="CENTER_LEFT">
                            <Label styleClass="search-icon" text="🔍"/>
                            <TextField fx:id="searchField"
                                       styleClass="search-field"
                                       promptText="Tìm kiếm sản phẩm, phiên đấu giá..."
                                       HBox.hgrow="ALWAYS"
                                       onAction="#handleSearchQuery"/>
                            <Label fx:id="resultCountLabel" styleClass="result-count" text=""/>
                        </HBox>
                    </HBox>

                    <ScrollPane styleClass="category-scroll"
                                fitToHeight="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="NEVER">
                        <HBox fx:id="categoryChipsContainer"
                              styleClass="category-chips-container"
                              spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="chipAll" styleClass="chip-active"
                                    text="✦ Tất cả" onAction="#handleCategoryAll"/>
                            <Button styleClass="chip" text="⌚ Đồng hồ" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="💎 Trang sức" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🎨 Nghệ thuật" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🏺 Đồ cổ" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🚗 Xe hơi" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🏡 Nội thất" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🏆 Sưu tầm" onAction="#handleCategoryFilter"/>
                            <Button styleClass="chip" text="🏢 Bất động sản" onAction="#handleCategoryFilter"/>
                        </HBox>
                    </ScrollPane>

                    <VBox spacing="16">
                        <VBox styleClass="section-header" spacing="4">
                            <Label styleClass="section-title" text="🔥 ĐẤU GIÁ NỔI BẬT"/>
                            <Label styleClass="section-subtitle"
                                   text="Những sản phẩm đấu giá nóng nhất hiện tại dựa trên hoạt động đặt giá"/>
                        </VBox>
                        <Region styleClass="gold-divider" maxWidth="180"/>
                        <HBox fx:id="hotCardsContainer" spacing="20" alignment="TOP_LEFT" fillHeight="true"/>
                    </VBox>

                    <Region styleClass="separator-line" maxWidth="10000"/>

                    <VBox styleClass="all-products-section" spacing="16">
                        <Label styleClass="all-products-title" text="Tất cả đấu giá"/>
                        <GridPane fx:id="allProductsGrid" hgap="16" vgap="16"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 2: Tab "Cá nhân"
                 ═══════════════════════════════════════════════════════════ -->
            <!--
    StackPane fx:id="profileOverlay" — giữ nguyên thuộc tính bên ngoài,
    chỉ thay NỘI DUNG bên trong.
-->
            <StackPane fx:id="profileOverlay"
                       visible="false"
                       managed="false"
                       styleClass="profile-overlay"
                       xmlns="http://javafx.com/javafx"
                       xmlns:fx="http://javafx.com/fxml">

                <!-- ══════════════════════════════════════════════════════════
                     PROFILE PAGE — Full-screen layout, 2-column design
                     ══════════════════════════════════════════════════════════ -->
                <ScrollPane fx:id="profileScrollPane" styleClass="profile-page-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <VBox styleClass="profile-page-root" spacing="0">

                        <!-- ── HERO BANNER ──────────────────────────────────── -->
                        <VBox styleClass="profile-hero-banner" spacing="0">
                            <!-- Gold accent top bar -->
                            <Region styleClass="profile-hero-accent-bar" minHeight="3" maxHeight="3"/>

                            <HBox styleClass="profile-hero-content" spacing="28" alignment="CENTER_LEFT">
                                <!-- Avatar -->
                                <StackPane styleClass="profile-hero-avatar-wrap">
                                    <StackPane styleClass="profile-large-avatar" minWidth="90" minHeight="90" maxWidth="90" maxHeight="90">
                                        <Label fx:id="profileAvatarGlyph" styleClass="profile-avatar-glyph" text="👤"/>
                                    </StackPane>
                                </StackPane>

                                <!-- Name + role + actions -->
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label fx:id="profileTitleLabel" styleClass="profile-hero-name" text="Cá nhân"/>
                                    <Label fx:id="profileHintLabel"
                                           wrapText="true"
                                           styleClass="profile-hero-subtitle"
                                           text="Đăng nhập để quản lý đấu giá, thông báo và ví."/>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Button fx:id="profileTabLoginButton"
                                                styleClass="btn-login-solid"
                                                text="Đăng nhập"
                                                visible="false" managed="false"
                                                onAction="#handleLogin"/>
                                        <Button fx:id="profileLogoutButton"
                                                styleClass="profile-logout-btn"
                                                text="Đăng xuất"
                                                visible="false" managed="false"
                                                onAction="#handleLogoutFromProfile"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- ── MAIN CONTENT: 2-column grid ─────────────────── -->
                        <HBox styleClass="profile-body-grid" spacing="20" alignment="TOP_LEFT">

                            <!-- LEFT COLUMN: Thông tin cá nhân -->
                            <VBox fx:id="profileInfoSection" styleClass="profile-body-card" spacing="0"
                                  visible="false" managed="false" HBox.hgrow="ALWAYS">

                                <!-- Card header -->
                                <HBox styleClass="profile-card-header" spacing="10" alignment="CENTER_LEFT">
                                    <Label styleClass="profile-card-header-icon" text="👤"/>
                                    <Label styleClass="profile-card-header-title" text="Thông tin cá nhân"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Region styleClass="profile-card-divider"/>

                                <!-- Info rows inside card -->
                                <VBox styleClass="profile-card-body" spacing="0">

                                    <!-- Họ tên -->
                                    <HBox styleClass="profile-field-row" spacing="14" alignment="CENTER_LEFT">
                                        <VBox styleClass="profile-field-icon-wrap" alignment="CENTER">
                                            <Label styleClass="profile-field-icon" text="✦"/>
                                        </VBox>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label styleClass="profile-field-label" text="HỌ VÀ TÊN"/>
                                            <Label fx:id="infoFullName" styleClass="profile-field-value" text="—"/>
                                        </VBox>
                                    </HBox>
                                    <Region styleClass="profile-field-separator"/>

                                    <!-- Email -->
                                    <HBox styleClass="profile-field-row" spacing="14" alignment="CENTER_LEFT">
                                        <VBox styleClass="profile-field-icon-wrap" alignment="CENTER">
                                            <Label styleClass="profile-field-icon" text="✉"/>
                                        </VBox>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label styleClass="profile-field-label" text="EMAIL"/>
                                            <Label fx:id="infoEmail" styleClass="profile-field-value" text="—"/>
                                        </VBox>
                                    </HBox>
                                    <Region styleClass="profile-field-separator"/>

                                    <!-- Số điện thoại -->
                                    <HBox styleClass="profile-field-row" spacing="14" alignment="CENTER_LEFT">
                                        <VBox styleClass="profile-field-icon-wrap" alignment="CENTER">
                                            <Label styleClass="profile-field-icon" text="📞"/>
                                        </VBox>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label styleClass="profile-field-label" text="SỐ ĐIỆN THOẠI"/>
                                            <Label fx:id="infoPhone" styleClass="profile-field-value" text="—"/>
                                        </VBox>
                                    </HBox>
                                    <Region styleClass="profile-field-separator"/>

                                    <!-- Vai trò -->
                                    <HBox styleClass="profile-field-row" spacing="14" alignment="CENTER_LEFT">
                                        <VBox styleClass="profile-field-icon-wrap" alignment="CENTER">
                                            <Label styleClass="profile-field-icon" text="🏷"/>
                                        </VBox>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label styleClass="profile-field-label" text="VAI TRÒ"/>
                                            <Label fx:id="infoRole" styleClass="profile-field-value" text="—"/>
                                        </VBox>
                                    </HBox>
                                    <Region styleClass="profile-field-separator"/>

                                    <!-- Ngày tham gia -->
                                    <HBox styleClass="profile-field-row" spacing="14" alignment="CENTER_LEFT">
                                        <VBox styleClass="profile-field-icon-wrap" alignment="CENTER">
                                            <Label styleClass="profile-field-icon" text="📅"/>
                                        </VBox>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label styleClass="profile-field-label" text="NGÀY THAM GIA"/>
                                            <Label fx:id="infoCreatedAt" styleClass="profile-field-value" text="—"/>
                                        </VBox>
                                    </HBox>

                                </VBox>
                            </VBox>

                            <!-- RIGHT COLUMN: Ví & Nạp tiền -->
                            <VBox styleClass="profile-body-col-right" spacing="20" minWidth="300" maxWidth="360">

                                <!-- Wallet card -->
                                <VBox fx:id="profileWalletSection" styleClass="profile-body-card" spacing="0"
                                      visible="false" managed="false">

                                    <HBox styleClass="profile-card-header" spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="profile-card-header-icon" text="💰"/>
                                        <Label styleClass="profile-card-header-title" text="Số dư &amp; Ví"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <Region styleClass="profile-card-divider"/>

                                    <VBox styleClass="profile-card-body" spacing="16">
                                        <!-- Balance display -->
                                        <VBox styleClass="wallet-balance-card" spacing="6" alignment="CENTER">
                                            <Label styleClass="wallet-label" text="SỐ DƯ HIỆN TẠI"/>
                                            <Label fx:id="walletBalanceLabel" styleClass="wallet-amount" text="0 ₫"/>
                                            <Label fx:id="walletTypeLabel" styleClass="wallet-type-badge" text="Ví"/>
                                        </VBox>

                                        <!-- Deposit button -->
                                        <Button fx:id="btnDeposit"
                                                styleClass="btn-deposit"
                                                text="＋  Nạp tiền"
                                                maxWidth="Infinity"
                                                onAction="#handleOpenDeposit"/>

                                        <!-- Quick amounts -->
                                        <HBox spacing="8" alignment="CENTER">
                                            <Button styleClass="btn-quick-amount" text="50K"
                                                    onAction="#handleQuickDeposit" userData="50000" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                            <Button styleClass="btn-quick-amount" text="100K"
                                                    onAction="#handleQuickDeposit" userData="100000" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                            <Button styleClass="btn-quick-amount" text="500K"
                                                    onAction="#handleQuickDeposit" userData="500000" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                            <Button styleClass="btn-quick-amount" text="1M"
                                                    onAction="#handleQuickDeposit" userData="1000000" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <!-- Hidden wallet divider (kept for controller compatibility) -->
                                <Region fx:id="walletDivider" visible="false" managed="false" minHeight="0" maxHeight="0"/>

                                <!-- Extras box -->
                                <VBox fx:id="profileExtrasBox" spacing="10" alignment="TOP_LEFT"/>

                            </VBox>

                        </HBox>

                    </VBox>
                </ScrollPane>

                <!-- ══════════════════════════════════════════════════════════════
                     DEPOSIT DIALOG — hiện đè lên profile page
                     ══════════════════════════════════════════════════════════════ -->
                <VBox fx:id="depositOverlay"
                      styleClass="deposit-overlay"
                      visible="false" managed="false"
                      alignment="CENTER">

                    <VBox styleClass="deposit-dialog" spacing="0" maxWidth="420">

                        <!-- Header dialog -->
                        <HBox styleClass="deposit-dialog-header" alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="deposit-dialog-title" text="Nạp tiền vào tài khoản" HBox.hgrow="ALWAYS"/>
                            <Button styleClass="deposit-close-btn" text="✕" onAction="#handleCloseDeposit"/>
                        </HBox>

                        <VBox styleClass="deposit-dialog-body" spacing="20">

                            <!-- Bước 1 -->
                            <VBox styleClass="deposit-step-box" spacing="12">
                                <Label styleClass="deposit-step-label" text="Bước 1 — Chuyển khoản đến tài khoản sau"/>
                                <VBox styleClass="bank-info-card" spacing="10">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label styleClass="bank-logo-badge" text="MB"/>
                                        <VBox spacing="2">
                                            <Label styleClass="bank-name" text="MBBank"/>
                                            <Label styleClass="bank-sub" text="Ngân hàng Quân đội"/>
                                        </VBox>
                                    </HBox>
                                    <Region styleClass="bank-divider"/>
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                                            <Label styleClass="bank-field-label" text="Số tài khoản"/>
                                            <Label fx:id="bankAccountNumber" styleClass="bank-account-number" text="0366855207"/>
                                        </VBox>
                                        <Button styleClass="btn-copy" text="📋 Sao chép" onAction="#handleCopyAccountNumber"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <VBox spacing="2">
                                            <Label styleClass="bank-field-label" text="Chủ tài khoản"/>
                                            <Label styleClass="bank-account-name" text="NGUYEN VAN HIEP"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Bước 2 -->
                            <VBox styleClass="deposit-step-box" spacing="10">
                                <Label styleClass="deposit-step-label" text="Bước 2 — Nhập số tiền bạn muốn nạp (VNĐ)"/>
                                <HBox styleClass="deposit-input-wrapper" alignment="CENTER_LEFT" spacing="8">
                                    <Label styleClass="deposit-currency-prefix" text="₫"/>
                                    <TextField fx:id="depositAmountField"
                                               styleClass="deposit-input"
                                               promptText="Nhập số tiền..."
                                               HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Label fx:id="depositAmountHint" styleClass="deposit-amount-hint" text="Tối thiểu: 10.000 ₫"/>
                            </VBox>

                            <!-- Trạng thái -->
                            <VBox fx:id="depositStatusBox" spacing="8" alignment="CENTER" visible="false" managed="false">
                                <Label fx:id="depositStatusIcon" styleClass="deposit-status-icon" text="⏳"/>
                                <Label fx:id="depositStatusText" styleClass="deposit-status-text"
                                       text="Đang xác nhận giao dịch..." wrapText="true" alignment="CENTER"/>
                            </VBox>

                            <!-- Nút xác nhận -->
                            <Button fx:id="btnConfirmDeposit"
                                    styleClass="btn-confirm-deposit"
                                    text="Xác nhận đã chuyển khoản"
                                    maxWidth="Infinity"
                                    onAction="#handleConfirmDeposit"/>

                            <Label styleClass="deposit-disclaimer"
                                   text="🔒  Hệ thống sẽ tự động cộng số dư sau khi xác nhận giao dịch."
                                   wrapText="true" alignment="CENTER"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ═══════════════════════════════════════════════════════════
                     GUEST PANE — Centered view when not logged in
                     ═══════════════════════════════════════════════════════════ -->
                <VBox fx:id="guestProfilePane"
                      alignment="CENTER"
                      spacing="20"
                      visible="false"
                      managed="false">
                    <StackPane alignment="CENTER"
                               minWidth="90" minHeight="90"
                               maxWidth="90" maxHeight="90"
                               styleClass="profile-large-avatar">
                        <Label styleClass="profile-avatar-glyph" text="👤"/>
                    </StackPane>
                    <Label styleClass="profile-hero-name"
                           text="Chưa đăng nhập"
                           alignment="CENTER"
                           textAlignment="CENTER"/>
                    <Label styleClass="profile-hero-subtitle"
                           text="Đăng nhập để xem hồ sơ, Số dư và Nạp tiền"
                           wrapText="true"
                           alignment="CENTER"
                           textAlignment="CENTER"
                           maxWidth="320"/>
                    <Button styleClass="btn-login-solid"
                            text="Đăng nhập"
                            onAction="#handleLogin"/>
                </VBox>

            </StackPane>


            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 3: Tab "Sản phẩm của tôi" — dành cho Người bán
                 Hiển thị danh sách sản phẩm + nút Đăng bán
                 ═══════════════════════════════════════════════════════════ -->
            <StackPane fx:id="myProductsOverlay"
                       visible="false"
                       managed="false"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       styleClass="my-products-overlay">

                <VBox styleClass="my-products-panel" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">

                    <!-- Header -->
                    <HBox styleClass="my-products-header" alignment="CENTER_LEFT">
                        <Label text="🏷" styleClass="my-products-header-icon"/>
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="Sản phẩm của tôi" styleClass="my-products-title"/>
                            <Label fx:id="myProductsSubtitle" text="Quản lý và theo dõi sản phẩm đang đấu giá"
                                   styleClass="my-products-subtitle"/>
                        </VBox>
                        <Button fx:id="btnListNewProduct"
                                styleClass="btn-list-product"
                                text="＋  Đăng bán sản phẩm"
                                onAction="#handleListNewProduct"/>
                    </HBox>

                    <!-- Danh sách sản phẩm (scrollable) -->
                    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS"
                                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox fx:id="myProductsList" styleClass="my-products-list" spacing="12"/>
                    </ScrollPane>

                </VBox>
            </StackPane>

            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 4: Điều khoản Người bán — hiện khi Buyer bấm "Sản phẩm của tôi"
                 Buyer phải đồng ý 3 điều khoản để nâng cấp thành Seller
                 ═══════════════════════════════════════════════════════════ -->
            <StackPane fx:id="sellerTermsOverlay"
                       visible="false"
                       managed="false"
                       styleClass="modal-overlay">

                <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            maxWidth="560">

                    <VBox styleClass="modal-card" spacing="20" alignment="TOP_CENTER">

                        <!-- Icon + tiêu đề -->
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="🏷" styleClass="modal-big-icon"/>
                            <Label text="Trở thành Người bán" styleClass="modal-title"/>
                            <Label text="Để đăng bán sản phẩm trên UBid, bạn cần đọc và đồng ý các điều khoản dành cho Người bán dưới đây."
                                   styleClass="modal-subtitle" wrapText="true" alignment="CENTER"
                                   maxWidth="420"/>
                        </VBox>

                        <!-- ── 3 điều khoản (giống RegisterView) ── -->
                        <VBox styleClass="seller-terms-section" spacing="10">

                            <HBox styleClass="terms-header" alignment="CENTER_LEFT" spacing="10">
                                <Label text="📋" styleClass="terms-header-icon"/>
                                <VBox>
                                    <Label text="ĐIỀU KHOẢN NGƯỜI BÁN" styleClass="terms-header-title"/>
                                    <Label text="Đọc và chấp nhận tất cả điều khoản để tiếp tục"
                                           styleClass="terms-header-sub" wrapText="true"/>
                                </VBox>
                            </HBox>

                            <!-- Điều khoản 1 -->
                            <VBox styleClass="terms-item">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <CheckBox fx:id="upgradeTermsMerchandise" styleClass="terms-check"/>
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Chính sách về Hàng hóa" styleClass="terms-item-title"/>
                                        <Label text="Quy định loại hàng được bán, tiêu chuẩn chất lượng và hàng cấm."
                                               styleClass="terms-item-desc" wrapText="true"/>
                                    </VBox>
                                    <Button text="Xem" styleClass="terms-view-btn"
                                            onAction="#onViewMerchandiseTermsUpgrade"/>
                                </HBox>
                                <Label fx:id="upgradeTermsMerchandiseError"
                                       styleClass="error-label, terms-error"
                                       text="⚠  Vui lòng chấp nhận chính sách hàng hóa"
                                       visible="false" managed="false"/>
                            </VBox>

                            <Separator styleClass="terms-sep"/>

                            <!-- Điều khoản 2 -->
                            <VBox styleClass="terms-item">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <CheckBox fx:id="upgradeTermsContent" styleClass="terms-check"/>
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Chính sách về Nội dung" styleClass="terms-item-title"/>
                                        <Label text="Quy định mô tả sản phẩm, hình ảnh và nội dung đăng tải."
                                               styleClass="terms-item-desc" wrapText="true"/>
                                    </VBox>
                                    <Button text="Xem" styleClass="terms-view-btn"
                                            onAction="#onViewContentTermsUpgrade"/>
                                </HBox>
                                <Label fx:id="upgradeTermsContentError"
                                       styleClass="error-label, terms-error"
                                       text="⚠  Vui lòng chấp nhận chính sách nội dung"
                                       visible="false" managed="false"/>
                            </VBox>

                            <Separator styleClass="terms-sep"/>

                            <!-- Điều khoản 3 -->
                            <VBox styleClass="terms-item">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <CheckBox fx:id="upgradeTermsPrivacy" styleClass="terms-check"/>
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Chính sách Bảo mật Thông tin" styleClass="terms-item-title"/>
                                        <Label text="Cách chúng tôi thu thập, sử dụng và bảo vệ thông tin cá nhân."
                                               styleClass="terms-item-desc" wrapText="true"/>
                                    </VBox>
                                    <Button text="Xem" styleClass="terms-view-btn"
                                            onAction="#onViewPrivacyTermsUpgrade"/>
                                </HBox>
                                <Label fx:id="upgradeTermsPrivacyError"
                                       styleClass="error-label, terms-error"
                                       text="⚠  Vui lòng chấp nhận chính sách bảo mật"
                                       visible="false" managed="false"/>
                            </VBox>

                        </VBox>

                        <!-- Nút hành động -->
                        <VBox spacing="10">
                            <Button text="✓  Đồng ý &amp; Trở thành Người bán"
                                    styleClass="btn-login-solid"
                                    maxWidth="Infinity"
                                    onAction="#handleAcceptSellerTerms"/>
                            <Button text="Hủy bỏ"
                                    styleClass="btn-outline-gold"
                                    maxWidth="Infinity"
                                    onAction="#handleCancelSellerTerms"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </StackPane>

            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 5: Form "Đăng bán sản phẩm"
                 Người bán điền thông tin, upload ảnh, mô tả sản phẩm
                 ═══════════════════════════════════════════════════════════ -->
            <!-- LOP 6: Man "Ket qua dau gia" -->
            <StackPane fx:id="resultsOverlay"
                       visible="false"
                       managed="false"
                       styleClass="results-overlay">

                <VBox styleClass="results-panel">
                    <HBox styleClass="results-header" alignment="CENTER_LEFT">
                        <Label text="&#x1F3C6;" styleClass="results-header-icon"/>
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="Kết quả đấu giá" styleClass="results-title"/>
                            <Label fx:id="resultsSubtitle"
                                   text="Các phiên đấu giá đã kết thúc"
                                   styleClass="results-subtitle"/>
                        </VBox>
                    </HBox>
                    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS"
                                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox fx:id="resultsList" styleClass="results-list" spacing="12"/>
                    </ScrollPane>
                </VBox>
            </StackPane>

            <!-- ═══════════════════════════════════════════════════════════
                 LỚP 7: Notification Panel — hiện khi user click bell icon
                 Backdrop mờ toàn màn hình, panel neo ở góc phải dưới navbar
                 ═══════════════════════════════════════════════════════════ -->
            <StackPane fx:id="notifOverlay"
                       visible="false"
                       managed="false"
                       styleClass="notif-backdrop"
                       onMouseClicked="#handleNotifBackdropClick">

                <VBox styleClass="notif-panel"
                      maxWidth="360"
                      StackPane.alignment="TOP_RIGHT"
                      translateX="-12"
                      translateY="12">

                    <!-- Header -->
                    <HBox styleClass="notif-panel-header" alignment="CENTER_LEFT" spacing="8">
                        <Label text="🔔" styleClass="notif-panel-icon"/>
                        <Label text="Thông báo" styleClass="notif-panel-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnMarkAllRead"
                                styleClass="notif-mark-all-btn"
                                text="Đánh dấu tất cả đã đọc"
                                onAction="#handleMarkAllRead"/>
                        <Button styleClass="notif-close-btn"
                                text="✕"
                                onAction="#handleCloseNotifications"/>
                    </HBox>

                    <!-- Danh sách thông báo (scrollable) -->
                    <ScrollPane fitToWidth="true"
                                styleClass="notif-scroll"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                VBox.vgrow="ALWAYS"
                                maxHeight="420">
                        <VBox fx:id="notifList" styleClass="notif-list"/>
                    </ScrollPane>

                </VBox>
            </StackPane>

            <StackPane fx:id="listProductOverlay"
                       visible="false"
                       managed="false"
                       styleClass="modal-overlay">

                <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            maxWidth="620">

                    <VBox styleClass="modal-card" spacing="20">

                        <!-- Header với nút quay lại -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Button text="← Quay lại"
                                    styleClass="btn-back"
                                    onAction="#handleBackToMyProducts"/>
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Đăng bán sản phẩm" styleClass="modal-title"/>
                                <Label text="Điền đầy đủ thông tin để tạo phiên đấu giá"
                                       styleClass="modal-subtitle"/>
                            </VBox>
                        </HBox>

                        <!-- ── Thông tin cơ bản ── -->
                        <VBox styleClass="form-section" spacing="14">
                            <Label text="📦  THÔNG TIN SẢN PHẨM" styleClass="form-section-title"/>

                            <VBox styleClass="field-group-dark" spacing="6">
                                <Label text="Tên sản phẩm *" styleClass="form-field-label"/>
                                <TextField fx:id="listProductTitleField"
                                           styleClass="form-input"
                                           promptText="Nhập tên sản phẩm rõ ràng, đầy đủ"/>
                                <Label fx:id="listProductTitleError"
                                       styleClass="form-error" wrapText="true"
                                       visible="false" managed="false"
                                       text="⚠  Vui lòng nhập tên sản phẩm"/>
                            </VBox>

                            <VBox styleClass="field-group-dark" spacing="6">
                                <Label text="Danh mục *" styleClass="form-field-label"/>
                                <ComboBox fx:id="listProductCategoryCombo"
                                          styleClass="form-combo"
                                          promptText="Chọn danh mục sản phẩm"
                                          maxWidth="Infinity"/>
                                <Label fx:id="listProductCategoryError"
                                       styleClass="form-error" wrapText="true"
                                       visible="false" managed="false"
                                       text="⚠  Vui lòng chọn danh mục"/>
                            </VBox>

                            <VBox styleClass="field-group-dark" spacing="6">
                                <Label text="Mô tả sản phẩm *" styleClass="form-field-label"/>
                                <TextArea fx:id="listProductDescArea"
                                          styleClass="form-textarea"
                                          promptText="Mô tả chi tiết tình trạng, xuất xứ, đặc điểm nổi bật của sản phẩm..."
                                          wrapText="true"
                                          prefRowCount="4"/>
                                <Label fx:id="listProductDescError"
                                       styleClass="form-error" wrapText="true"
                                       visible="false" managed="false"
                                       text="⚠  Vui lòng mô tả sản phẩm (ít nhất 20 ký tự)"/>
                            </VBox>
                        </VBox>

                        <!-- ── Hình ảnh sản phẩm ── -->
                        <VBox styleClass="form-section" spacing="14">
                            <Label text="🖼  HÌNH ẢNH SẢN PHẨM" styleClass="form-section-title"/>

                            <!-- Vùng upload ảnh — nội dung được fill từ controller
                                 (icon mặc định khi trống, preview ảnh sau khi chọn) -->
                            <StackPane fx:id="imageUploadBox"
                                       styleClass="image-upload-box"
                                       onMouseClicked="#handleImageUpload"
                                       minHeight="160"
                                       alignment="CENTER"/>

                            <Label fx:id="listProductImageError"
                                   styleClass="form-error" wrapText="true"
                                   visible="false" managed="false"
                                   text="⚠  Vui lòng chọn ít nhất 1 hình ảnh"/>
                        </VBox>

                        <!-- ── Thông tin đấu giá ── -->
                        <VBox styleClass="form-section" spacing="14">
                            <Label text="💰  CÀI ĐẶT ĐẤU GIÁ" styleClass="form-section-title"/>

                            <HBox spacing="14">
                                <VBox HBox.hgrow="ALWAYS" styleClass="field-group-dark" spacing="6">
                                    <Label text="Giá khởi điểm (VNĐ) *" styleClass="form-field-label"/>
                                    <TextField fx:id="listProductPriceField"
                                               styleClass="form-input"
                                               promptText="Ví dụ: 500000"/>
                                    <Label fx:id="listProductPriceError"
                                           styleClass="form-error" wrapText="true"
                                           visible="false" managed="false"
                                           text="⚠  Vui lòng nhập giá hợp lệ"/>
                                </VBox>

                                <VBox HBox.hgrow="ALWAYS" styleClass="field-group-dark" spacing="6">
                                    <Label text="Thời gian kết thúc *" styleClass="form-field-label"/>
                                    <!--
                                        Chia thành 2 dòng:
                                          Dòng 1 — DatePicker chọn ngày
                                          Dòng 2 — Giờ + Phút (ComboBox) + preview thời gian thực
                                        Tại sao dùng ComboBox cho giờ/phút thay vì TextField?
                                        → ComboBox giới hạn input hợp lệ ngay từ đầu (0-23, 0-59),
                                          không cần validate thủ công và không bị nhập chữ.
                                    -->
                                    <DatePicker fx:id="listProductEndDate"
                                                styleClass="form-datepicker"
                                                promptText="Chọn ngày kết thúc"
                                                maxWidth="Infinity"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="🕐" style="-fx-font-size:16px;"/>
                                        <ComboBox fx:id="listProductEndHour"
                                                  styleClass="form-time-combo"
                                                  promptText="Giờ"
                                                  prefWidth="80"/>
                                        <Label text=":" styleClass="form-time-sep"/>
                                        <ComboBox fx:id="listProductEndMinute"
                                                  styleClass="form-time-combo"
                                                  promptText="Phút"
                                                  prefWidth="80"/>
                                    </HBox>
                                    <!-- Preview hiện trên dòng riêng để không bị cắt chữ -->
                                    <Label fx:id="lblEndTimePreview"
                                           styleClass="form-time-preview"
                                           text=""
                                           wrapText="true"/>
                                    <Label fx:id="listProductDateError"
                                           styleClass="form-error" wrapText="true"
                                           visible="false" managed="false"
                                           text="⚠  Vui lòng chọn ngày kết thúc"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Nút submit -->
                        <VBox spacing="10">
                            <Button text="🏷  Đăng bán sản phẩm"
                                    styleClass="btn-login-solid"
                                    maxWidth="Infinity"
                                    onAction="#handleSubmitProduct"/>
                            <Label fx:id="submitProductError"
                                   styleClass="form-error" wrapText="true"
                                   visible="false" managed="false"
                                   text=""/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </StackPane>

            <!-- ═══════════════════════════════════════════════════════════
                 ADMIN PANEL OVERLAY
                 Thay thế profileOverlay khi admin bấm tab "Cá nhân"
                 ═══════════════════════════════════════════════════════════ -->
            <StackPane fx:id="adminOverlay"
                       visible="false"
                       managed="false"
                       styleClass="profile-overlay">

                <ScrollPane styleClass="profile-page-scroll" fitToWidth="true"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <VBox styleClass="profile-page-root" spacing="0">

                        <!-- ── HERO BANNER ────────────────────────────────── -->
                        <VBox styleClass="profile-hero-banner" spacing="0">
                            <Region styleClass="admin-accent-bar" minHeight="3" maxHeight="3"/>
                            <HBox styleClass="profile-hero-content" spacing="20" alignment="CENTER_LEFT">
                                <StackPane styleClass="admin-avatar-circle"
                                           minWidth="66" minHeight="66" maxWidth="66" maxHeight="66">
                                    <Label styleClass="admin-avatar-glyph" text="⚡"/>
                                </StackPane>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label styleClass="admin-title" text="Bảng quản trị"/>
                                    <Label fx:id="adminSubtitleLabel" styleClass="admin-subtitle"
                                           text="Quản lý người dùng và phiên đấu giá"/>
                                    <Label fx:id="adminLevelBadge" styleClass="admin-badge-role" text="Quản trị viên"/>
                                </VBox>
                                <Button styleClass="profile-logout-btn" text="Đăng xuất"
                                        onAction="#handleLogoutFromProfile"/>
                            </HBox>
                        </VBox>

                        <!-- ── TAB BAR ────────────────────────────────────── -->
                        <!--
                            Mỗi tab = VBox[Button + Region indicator].
                            Region indicator là đường 2px nằm NGOÀI button,
                            sát đáy HBox — không bị ảnh hưởng bởi button padding.
                            Java chỉ cần đổi style của Region, không đụng button border.
                        -->
                        <HBox styleClass="admin-tab-bar" spacing="0"
                              maxWidth="Infinity" VBox.vgrow="NEVER">
                            <!--
                                StackPane approach:
                                - Button chiem toan bo chieu cao StackPane
                                - Region indicator (2px) duoc pin xuong day bang StackPane.alignment=BOTTOM_CENTER
                                - Khong bi anh huong boi button padding hay Modena sizing
                            -->
                            <StackPane HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Button fx:id="adminTabUsers"
                                        styleClass="admin-tab-btn admin-tab-active"
                                        text="👥  Người dùng"
                                        onAction="#handleAdminTabUsers"
                                        focusTraversable="false"
                                        maxWidth="Infinity" maxHeight="Infinity"
                                        StackPane.alignment="CENTER"/>
                                <Region fx:id="adminTabUsersIndicator"
                                        maxWidth="Infinity" minHeight="2" maxHeight="2"
                                        style="-fx-background-color: #c9a84c;"
                                        StackPane.alignment="BOTTOM_CENTER"
                                        mouseTransparent="true"/>
                            </StackPane>
                            <StackPane HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <Button fx:id="adminTabAuctions"
                                        styleClass="admin-tab-btn"
                                        text="🔨  Phiên đấu giá"
                                        onAction="#handleAdminTabAuctions"
                                        focusTraversable="false"
                                        maxWidth="Infinity" maxHeight="Infinity"
                                        StackPane.alignment="CENTER"/>
                                <Region fx:id="adminTabAuctionsIndicator"
                                        maxWidth="Infinity" minHeight="2" maxHeight="2"
                                        style="-fx-background-color: transparent;"
                                        StackPane.alignment="BOTTOM_CENTER"
                                        mouseTransparent="true"/>
                            </StackPane>
                        </HBox>

                        <!-- ── CONTENT BODY ────────────────────────────────── -->
                        <VBox styleClass="admin-body" spacing="0">

                            <StackPane>

                                <!-- PANEL 1: Người dùng -->
                                <VBox fx:id="adminUsersPanel" styleClass="admin-panel" spacing="14">

                                    <!-- Toolbar -->
                                    <HBox styleClass="admin-toolbar" spacing="10" alignment="CENTER_LEFT">
                                        <HBox styleClass="admin-search-box" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-search-icon-lbl" text="🔍"/>
                                            <TextField fx:id="adminUserSearchField"
                                                       styleClass="admin-search-field"
                                                       promptText="Tìm username, email..."
                                                       HBox.hgrow="ALWAYS"
                                                       onKeyReleased="#handleAdminUserSearch"/>
                                        </HBox>
                                        <ComboBox fx:id="adminUserRoleFilter"
                                                  styleClass="admin-combo"
                                                  promptText="Tất cả"/>
                                        <Button styleClass="admin-refresh-btn" text="↻ Làm mới"
                                                onAction="#handleAdminLoadUsers"/>
                                    </HBox>

                                    <!-- Table header -->
                                    <HBox styleClass="admin-table-head" spacing="0">
                                        <Label styleClass="admin-th" text="ID"         minWidth="55"  maxWidth="55"/>
                                        <Label styleClass="admin-th" text="Username"   minWidth="140" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="admin-th" text="Email"      minWidth="190" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="admin-th" text="Vai trò"    minWidth="115" maxWidth="115"/>
                                        <Label styleClass="admin-th" text="Trạng thái" minWidth="115" maxWidth="115"/>
                                        <Label styleClass="admin-th" text="Hành động"  minWidth="130" maxWidth="130"/>
                                    </HBox>

                                    <!-- Rows (populated by Java) -->
                                    <VBox fx:id="adminUsersList" styleClass="admin-table-body" spacing="0"/>

                                    <!-- Empty state -->
                                    <VBox fx:id="adminUsersEmpty" spacing="10" alignment="CENTER"
                                          visible="false" managed="false" minHeight="120">
                                        <Label styleClass="admin-empty-icon" text="👥"/>
                                        <Label styleClass="admin-empty-text" text="Không tìm thấy người dùng nào"/>
                                    </VBox>

                                </VBox>

                                <!-- PANEL 2: Phiên đấu giá -->
                                <VBox fx:id="adminAuctionsPanel" styleClass="admin-panel" spacing="14"
                                      visible="false" managed="false">

                                    <!-- Toolbar -->
                                    <HBox styleClass="admin-toolbar" spacing="10" alignment="CENTER_LEFT">
                                        <HBox styleClass="admin-search-box" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-search-icon-lbl" text="🔍"/>
                                            <TextField fx:id="adminAuctionSearchField"
                                                       styleClass="admin-search-field"
                                                       promptText="Tìm tên phiên đấu giá..."
                                                       HBox.hgrow="ALWAYS"
                                                       onKeyReleased="#handleAdminAuctionSearch"/>
                                        </HBox>
                                        <ComboBox fx:id="adminAuctionStatusFilter"
                                                  styleClass="admin-combo"
                                                  promptText="Tất cả"/>
                                        <Button styleClass="admin-refresh-btn" text="↻ Làm mới"
                                                onAction="#handleAdminLoadAuctions"/>
                                    </HBox>

                                    <!-- Table header -->
                                    <HBox styleClass="admin-table-head" spacing="0">
                                        <Label styleClass="admin-th" text="ID"           minWidth="55"  maxWidth="55"/>
                                        <Label styleClass="admin-th" text="Tên phiên"    minWidth="180" HBox.hgrow="ALWAYS"/>
                                        <Label styleClass="admin-th" text="Người bán"    minWidth="120" maxWidth="120"/>
                                        <Label styleClass="admin-th" text="Giá hiện tại" minWidth="130" maxWidth="130"/>
                                        <Label styleClass="admin-th" text="Trạng thái"   minWidth="115" maxWidth="115"/>
                                        <Label styleClass="admin-th" text="Hành động"    minWidth="140" maxWidth="140"/>
                                    </HBox>

                                    <!-- Rows (populated by Java) -->
                                    <VBox fx:id="adminAuctionsList" styleClass="admin-table-body" spacing="0"/>

                                    <!-- Empty state -->
                                    <VBox fx:id="adminAuctionsEmpty" spacing="10" alignment="CENTER"
                                          visible="false" managed="false" minHeight="120">
                                        <Label styleClass="admin-empty-icon" text="🔨"/>
                                        <Label styleClass="admin-empty-text" text="Không có phiên đấu giá nào"/>
                                    </VBox>

                                </VBox>

                            </StackPane>
                        </VBox>

                    </VBox>
                </ScrollPane>

            </StackPane>



        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="bottom-nav" spacing="0" alignment="CENTER" maxWidth="Infinity">
            <ToggleButton fx:id="bottomNavHome" styleClass="bottom-nav-tab" text="Trang chủ"
                          onAction="#handleNavHome"/>
            <!-- "Danh mục" đổi thành "Sản phẩm của tôi" — dành cho Người bán -->
            <ToggleButton fx:id="bottomNavMyProducts" styleClass="bottom-nav-tab" text="Sản phẩm của tôi"
                          onAction="#handleMyProductsTab"/>
            <ToggleButton fx:id="bottomNavProfile" styleClass="bottom-nav-tab" text="Cá nhân"
                          onAction="#handleProfileTab"/>
        </HBox>
    </bottom>

</BorderPane>
